(actor)\n  if actor == nil or not actor.isLocal then return end\n  applyTeleport(actor)\nend\n\nfunction OnActorTriggerExit(actor)\nend"}],"bindings":[{"bindingId":"-35228:fc4dd815-40f2-4300-944e-63660930fcb4","instanceId":"-35228","modelIndex":0,"scriptId":"fc4dd815-40f2-4300-944e-63660930fcb4","referenceName":"world-interface-anchor.lua","params":{"TargetX":20,"TargetY":1,"TargetZ":0,"TargetYaw":90,"CooldownSeconds":0.5},"status":"attached","targetPath":"previewGameRoot/A探针_世界接口传送锚点/Anchor_A_to_B"},{"bindingId":"-35238:fc4dd815-40f2-4300-944e-63660930fcb4","instanceId":"-35238","modelIndex":0,"scriptId":"fc4dd815-40f2-4300-944e-63660930fcb4","referenceName":"world-interface-anchor.lua","params":{"TargetX":0,"TargetY":1,"TargetZ":0,"TargetYaw":90,"CooldownSeconds":0.5},"status":"attached","targetPath":"previewGameRoot/A探针_世界接口传送锚点/Anchor_B_to_A"},{"bindingId":"-35466:fc4dd815-40f2-4300-944e-63660930fcb4","instanceId":"-35466","modelIndex":0,"scriptId":"fc4dd815-40f2-4300-944e-63660930fcb4","referenceName":"world-interface-anchor.lua","params":{"TargetX":20,"TargetY":1,"TargetZ":0,"TargetYaw":90,"CooldownSeconds":0.5},"status":"attached","targetPath":"previewGameRoot/A探针_锚点带碰撞/Anchor_A_to_B"},{"bindingId":"-35480:fc4dd815-40f2-4300-944e-63660930fcb4","instanceId":"-35480","modelIndex":0,"scriptId":"fc4dd815-40f2-4300-944e-63660930fcb4","referenceName":"world-interface-anchor.lua","params":{"TargetX":0,"TargetY":1,"TargetZ":0,"TargetYaw":90,"CooldownSeconds":0.5},"status":"attached","targetPath":"previewGameRoot/A探针_锚点带碰撞/Anchor_B_to_A"},{"bindingId":"-35712:fc4dd815-40f2-4300-944e-63660930fcb4","instanceId":"-35712","modelIndex":0,"scriptId":"fc4dd815-40f2-4300-944e-63660930fcb4","referenceName":"world-interface-anchor.lua","params":{"TargetX":20,"TargetY":1,"TargetZ":0,"TargetYaw":90,"CooldownSeconds":0.5},"status":"attached","targetPath":"previewGameRoot/A探针_锚点地形上/Anchor_A_to_B"},{"bindingId":"-35726:fc4dd815-40f2-4300-944e-63660930fcb4","instanceId":"-35726","mod