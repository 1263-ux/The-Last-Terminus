r=0.5\n---@name 冷却秒数\n---@end\n\nlocal lastTeleportTime = -100\n\nlocal function applyTeleport(actor)\n  if actor == nil or not actor.isLocal then return end\n  if CS.UnityEngine.Time.time - lastTeleportTime < CooldownSeconds then return end\n  lastTeleportTime = CS.UnityEngine.Time.time\n  local pos = CS.UnityEngine.Vector3(TargetX, TargetY, TargetZ)\n  local rot = CS.UnityEngine.Quaternion.Euler(0, TargetYaw, 0)\n  actor:Teleport(pos, rot)\nend\n\nfunction OnActorTriggerEnter(actor)\n  if actor == nil or not actor.isLocal then return end\n  applyTeleport(actor)\nend\n\nfunction OnActorTriggerExit(actor)\nend"}],"bindings":[{"bindingId":"-22884:fc4dd815-40f2-4300-944e-63660930fcb4","instanceId":"-22884","modelIndex":0,"scriptId":"fc4dd815-40f2-4300-944e-63660930fcb4","referenceName":"world-interface-anchor.lua","params":{"TargetX":20,"TargetY":1,"TargetZ":0,"TargetYaw":90,"CooldownSeconds":0.5},"status":"attached","targetPath":"previewGameRoot/A探针_世界接口传送锚点/Anchor_A_to_B"},{"bindingId":"-22894:fc4dd815-40f2-4300-944e-63660930fcb4","instanceId":"-22894","modelIndex":0,"scriptId":"fc4dd815-40f2-4300-944e-63660930fcb4","referenceName":"world-interface-anchor.lua","params":{"TargetX":0,"TargetY":1,"TargetZ":0,"TargetYaw":90,"CooldownSeconds":0.5},"status":"attached","targetPath":"previewGameRoot/A探针_世界接口传送锚点/Anchor_B_to_A"}]}}
