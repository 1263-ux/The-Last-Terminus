gs":[{"bindingId":"-2090:fc4dd815-40f2-4300-944e-63660930fcb4","instanceId":"-2090","modelIndex":0,"scriptId":"fc4dd815-40f2-4300-944e-63660930fcb4","referenceName":"world-interface-anchor.lua","params":{"TargetX":0,"TargetY":1,"TargetZ":0,"TargetYaw":90,"CooldownSeconds":0.5},"status":"attached","targetPath":"previewGameRoot/跨工程交接_锚点/Anchor_B_to_A"}],"children":[]}]}]},"scripts":[{"modelIndex":0,"scriptId":"fc4dd815-40f2-4300-944e-63660930fcb4","referenceName":"world-interface-anchor.lua","source":"---@id fc4dd815-40f2-4300-944e-63660930fcb4\n---@referenceName world-interface-anchor.lua\n---@displayName 世界接口_传送锚点\n-- The Last Terminus / A-01 -- World Interface Anchor.\n-- 进入 Trigger 的本地玩家被传送到目标位置与朝向。\n---@start\n---@var TargetX:number=0\n---@name 目标 X\n---@var TargetY:number=1\n---@name 目标 Y\n---@var TargetZ:number=0\n---@name 目标 Z\n---@var TargetYaw:number=0\n---@name 目标朝向\n---@var CooldownSeconds:number=0.5\n---@name 冷却秒数\n---@end\n\nlocal lastTeleportTime = -100\n\nlocal function applyTeleport(actor)\n  if actor == nil or not actor.isLocal then return end\n  if CS.UnityEngine.Time.time - lastTeleportTime < CooldownSeconds then return end\n  lastTeleportTime = CS.UnityEngine.Time.time\n  local pos = CS.UnityEngine.Vector3(TargetX, TargetY, TargetZ)\n  local rot = CS.UnityEngine.Quaternion.Euler(0, TargetYaw, 0)\n  actor:Teleport(pos, rot)\nend\n\nfunction OnActorTriggerEnter(actor)\n  if actor == nil or not actor.isLocal then return end\n  applyTeleport(actor)\nend\n\nfunction OnActorTriggerExit(actor)\nend"}],"bindings":[{"bindingId":"-2076:fc4dd815-40f2-4300-944e-63660930fcb4","instanceId":"-2076","modelIndex":0,"scriptId":"fc4dd815-40f2-4300-944e-63660930fcb4","referenceName":"world-interface-anchor.lua","params":{"TargetX":20,"TargetY":1,"TargetZ":0,"TargetYaw":90,"CooldownSeconds":0.5},"status":"attached","targetPath":"previewGameRoot/跨工程交接_锚点/Anchor_A_to_B"},{"bindingId":"-2090:fc4dd815-40f2-4300-944e-63660930fcb4","instanceId":"-2090","modelIndex":0,"scrip