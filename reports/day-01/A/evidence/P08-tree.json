nction OnActorTriggerExit(actor)\nend"}],"bindings":[{"bindingId":"-8888:fc4dd815-40f2-4300-944e-63660930fcb4","instanceId":"-8888","modelIndex":0,"scriptId":"fc4dd815-40f2-4300-944e-63660930fcb4","referenceName":"world-interface-anchor.lua","params":{"TargetX":119.74,"TargetY":79.2,"TargetZ":103,"TargetYaw":180,"CooldownSeconds":2},"status":"attached","targetPath":"previewGameRoot/A探针_往返验证/Anchor_A_to_B"},{"bindingId":"-8902:fc4dd815-40f2-4300-944e-63660930fcb4","instanceId":"-8902","modelIndex":0,"scriptId":"fc4dd815-40f2-4300-944e-63660930fcb4","referenceName":"world-interface-anchor.lua","params":{"TargetX":119.74,"TargetY":79.2,"TargetZ":86,"TargetYaw":0,"CooldownSeconds":2},"status":"attached","targetPath":"previewGameRoot/A探针_往返验证/Anchor_B_to_A"},{"bindingId":"-9134:fc4dd815-40f2-4300-944e-63660930fcb4","instanceId":"-9134","modelIndex":0,"scriptId":"fc4dd815-40f2-4300-944e-63660930fcb4","referenceName":"world-interface-anchor.lua","params":{"TargetX":119.74,"TargetY":79.2,"TargetZ":103,"TargetYaw":180,"CooldownSeconds":2},"status":"attached","targetPath":"previewGameRoot/A_列车Hub灰盒/Anchor_A_to_B"},{"bindingId":"-9148:fc4dd815-40f2-4300-944e-63660930fcb4","instanceId":"-9148","modelIndex":0,"scriptId":"fc4dd815-40f2-4300-944e-63660930fcb4","referenceName":"world-interface-anchor.lua","params":{"TargetX":119.74,"TargetY":79.2,"TargetZ":86,"TargetYaw":0,"CooldownSeconds":2},"status":"attached","targetPath":"previewGameRoot/A_列车Hub灰盒/Anchor_B_to_A"}]}}
